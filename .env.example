# Binance API Configuration
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Agent Sub-Account Configuration
BINANCE_SUB_ACCOUNT_ID=your_sub_account_id
BINANCE_SUB_ACCOUNT_EMAIL=agent_subaccount@example.com

# Trading Mode
# Options: paper (sandbox), live
AGENT_MODE=paper
USE_TESTNET=true

# Trading Configuration
DEFAULT_TRADING_PAIR=BTCUSDT
DEFAULT_QUOTE_ASSET=USDT
MAX_POSITION_SIZE_USD=1000
MAX_DAILY_LOSS_PERCENT=5

# Risk Management
STOP_LOSS_PERCENT=2.0
TAKE_PROFIT_PERCENT=5.0
TRAILING_STOP_PERCENT=1.5
MAX_LEVERAGE=1  # 1 = no leverage for spot trading

# MCP Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
MCP_LOG_LEVEL=INFO

# LLM Configuration (for AI decision making)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4
ANTHROPIC_API_KEY=your_anthropic_api_key

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/trading_agent.log
LOG_MAX_BYTES=104857600  # 100MB
LOG_BACKUP_COUNT=10

# Database Configuration
DATABASE_URL=sqlite:///trading_agent.db
# For production: postgresql://user:password@localhost/binance_agent

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Feature Flags
ENABLE_BACKTESTING=true
ENABLE_PAPER_TRADING=true
ENABLE_LIVE_TRADING=false

# Notification Configuration
SLACK_WEBHOOK_URL=
EMAIL_ALERTS_ENABLED=false
EMAIL_RECIPIENT=your_email@example.com

# Security & Rate Limiting
API_RATE_LIMIT_REQUESTS=1000
API_RATE_LIMIT_WINDOW_SECONDS=60
MAX_ORDERS_PER_MINUTE=10

# Approval Workflow
REQUIRE_APPROVAL_FOR_TRADES=true
APPROVAL_TIMEOUT_SECONDS=300

# Data Retention
KEEP_TRADE_HISTORY_DAYS=365
KEEP_LOGS_DAYS=90
